[Unit]
Description=Agent Mesh Relay — Secure inter-agent messaging
After=network.target

[Service]
Type=simple
User=agent-mesh
Group=agent-mesh
ExecStart=/opt/agent-mesh/start-relay.sh
WorkingDirectory=/opt/agent-mesh
Restart=always
RestartSec=5
CPUQuota=20%
MemoryMax=30M
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
